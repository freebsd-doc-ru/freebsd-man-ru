.Nm install
.Nd устанавливает двоичные файлы
.Sh СИНТАКСИС
.Nm
.Op Fl bCcpSsUv
.Op Fl B Ar суффикс
.Op Fl D Ar destdir
.Op Fl f Ar флаги
.Op Fl g Ar группа
.Op Fl h Ar хэш
.Op Fl l Ar linkflags
.Op Fl M Ar metalog
.Op Fl m Ar режим
.Op Fl N Ar dbdir
.Op Fl o Ar владелец
.Op Fl T Ar теги
.Ar файл1 файл2
.Nm
.Op Fl bCcpSsUv
.Op Fl B Ar суффикс
.Op Fl D Ar destdir
.Op Fl f Ar флаги
.Op Fl g Ar группа
.Op Fl h Ar хэш
.Op Fl l Ar linkflags
.Op Fl M Ar metalog
.Op Fl m Ar режим
.Op Fl N Ar dbdir
.Op Fl o Ar владелец
.Op Fl T Ar теги
.Ar файл1 ... файлN каталог
