.Dd October 31, 2021
.Dt DEVCTL 8
.Os
.Sh ИМЯ
.Nm devctl
.Nd утилита управления устройствами
.Sh СИНТАКСИС
.Nm
.Cm attach
.Ar устройство
.Nm
.Cm clear driver
.Op Fl f
.Ar устройство
.Nm
.Cm detach
.Op Fl f
.Ar устройство
.Nm
.Cm disable
.Op Fl f
.Ar устройство
.Nm
.Cm enable
.Ar устройство
.Nm
.Cm suspend
.Ar устройство
.Nm
.Cm resume
.Ar устройство
.Nm
.Cm set driver
.Op Fl f
.Ar устройство драйвер
.Nm
.Cm rescan
.Ar устройство
.Nm
.Cm delete
.Op Fl f
.Ar устройство
.Nm
.Cm freeze
.Nm
