 * Идентификация файловой системы
 */
#define	FS_UFS1_MAGIC	0x011954    /* магическое число быстрой файловой системы UFS1 */
#define	FS_UFS2_MAGIC	0x19540119  /* магическое число быстрой файловой системы UFS2 */
#define	FS_OKAY		0x7c269d38  /* контрольная сумма суперблока */
