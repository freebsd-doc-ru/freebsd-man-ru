.Dd January 25, 2025
.Dt RPC.TLSSERVD 8
.Os
.Sh ИМЯ
.Nm rpc.tlsservd
.Sh СИНТАКСИС
.Nm
.Op Fl 2
.Op Fl C Ar available_ciphers
.Op Fl D Ar certdir
.Op Fl d
.Op Fl h
.Op Fl l Ar CAfile
.Op Fl m
.Op Fl N Ar max_threads
