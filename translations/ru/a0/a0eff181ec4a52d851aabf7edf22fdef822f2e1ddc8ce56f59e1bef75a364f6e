provider\-mac \- Функции библиотеки mac <\-> провайдера
.Vb 2
\& #include <openssl/core_dispatch.h>
\& #include <openssl/core_names.h>
\&
\& /*
\&  * Ни одна из этих функций не является реальной функцией, но они отображаются так
\&  * для сигнатур функций, которые предлагаются как указатели на функции
\&  * в массивах OSSL_DISPATCH.
\&  */
\&
\& /* Управление контекстом */
\& void *OSSL_FUNC_mac_newctx(void *provctx);
\& void OSSL_FUNC_mac_freectx(void *mctx);
\& void *OSSL_FUNC_mac_dupctx(void *src);
\&
\& /* Шифрование/дешифрование */
\& int OSSL_FUNC_mac_init(void *mctx, unsigned char *key, size_t keylen,
\&                        const OSSL_PARAM params[]);
\& int OSSL_FUNC_mac_update(void *mctx, const unsigned char *in, size_t inl);
\& int OSSL_FUNC_mac_final(void *mctx, unsigned char *out, size_t *outl, size_t outsize);
\&
\& /* Дескрипторы параметров MAC */
\& const OSSL_PARAM *OSSL_FUNC_mac_gettable_params(void *provctx);
\& const OSSL_PARAM *OSSL_FUNC_mac_gettable_ctx_params(void *mctx, void *provctx);
\& const OSSL_PARAM *OSSL_FUNC_mac_settable_ctx_params(void *mctx, void *provctx);
\&
\& /* Параметры MAC */
\& int OSSL_FUNC_mac_get_params(OSSL_PARAM params[]);
\& int OSSL_FUNC_mac_get_ctx_params(void *mctx, OSSL_PARAM params[]);
\& int OSSL_FUNC_mac_set_ctx_params(void *mctx, const OSSL_PARAM params[]);
.Ve
Эта документация в первую очередь предназначена для авторов провайдеров. Дополнительные сведения см. в \fBprovider\fR\|(7).
.PP
Операция \s-1MAC\s0 позволяет провайдерам реализовывать алгоритмы mac и предоставлять их приложениям через \s-1API\s0-функции \fBEVP_MAC_init\fR\|(3), \fBEVP_MAC_update\fR\|(3) и \fBEVP_MAC_final\fR\|(3).
.PP
\&\fIlibcrypto\fR и провайдер в массивах \s-1\fBOSSL_DISPATCH\s0\fR\|(3) через массивы \&\s-1\fBOSSL_ALGORITHM\s0\fR\|(3), которые возвращаются функцией провайдера \fBprovider_query_operation()\fR
.PP
с именем \fBOSSL_FUNC_{name}_fn\fR, и вспомогательная функция для получения указателя на функцию из элемента \s-1\fBOSSL_DISPATCH\s0\fR\|(3) с именем \fBOSSL_FUNC_{name}\fR.
.PP
.Vb 3
\& typedef void *(OSSL_FUNC_mac_newctx_fn)(void *provctx);
\& static ossl_inline OSSL_FUNC_mac_newctx_fn
\&     OSSL_FUNC_mac_newctx(const OSSL_DISPATCH *opf);
.Ve
.PP
\&\s-1\fBOSSL_DISPATCH\s0\fR\|(3) массивы индексируются числами, которые предоставляются в виде макросов в \fBopenssl\-core_dispatch.h\fR\|(7), следующим образом:
.PP
.Vb 3
\& OSSL_FUNC_mac_newctx               OSSL_FUNC_MAC_NEWCTX
\& OSSL_FUNC_mac_freectx              OSSL_FUNC_MAC_FREECTX
\& OSSL_FUNC_mac_dupctx               OSSL_FUNC_MAC_DUPCTX
\&
\& OSSL_FUNC_mac_init                 OSSL_FUNC_MAC_INIT
\& OSSL_FUNC_mac_update               OSSL_FUNC_MAC_UPDATE
\& OSSL_FUNC_mac_final                OSSL_FUNC_MAC_FINAL
\&
\& OSSL_FUNC_mac_get_params           OSSL_FUNC_MAC_GET_PARAMS
\& OSSL_FUNC_mac_get_ctx_params       OSSL_FUNC_MAC_GET_CTX_PARAMS
\& OSSL_FUNC_mac_set_ctx_params       OSSL_FUNC_MAC_SET_CTX_PARAMS
\&
\& OSSL_FUNC_mac_gettable_params      OSSL_FUNC_MAC_GETTABLE_PARAMS
\& OSSL_FUNC_mac_gettable_ctx_params  OSSL_FUNC_MAC_GETTABLE_CTX_PARAMS
\& OSSL_FUNC_mac_settable_ctx_params  OSSL_FUNC_MAC_SETTABLE_CTX_PARAMS
.Ve
.PP
Реализация алгоритма mac может не реализовывать все эти функции. Чтобы набор функций был согласованным, необходимо реализовать как минимум следующие функции: \fBOSSL_FUNC_mac_newctx()\fR, \fBOSSL_FUNC_mac_freectx()\fR, \fBOSSL_FUNC_mac_init()\fR, \fBOSSL_FUNC_mac_update()\fR, \fBOSSL_FUNC_mac_final()\fR. Все остальные функции необязательны.
\fBOSSL_FUNC_mac_newctx()\fR должна создавать и возвращать указатель на структуру стороны провайдера для хранения информации о контексте во время операции mac. Указатель на этот контекст будет передаваться обратно в ряде других вызовов функций операций mac. Параметр \fIprovctx\fR — это контекст провайдера, созданный при инициализации провайдера (см. \fBprovider\fR\|(7)).
.PP
\&\fBOSSL_FUNC_mac_freectx()\fR передаётся указатель на контекст mac стороны провайдера в параметре \fImctx\fR. Если она получает \s-1NULL\s0 в качестве значения \fImctx\fR, она не должна делать ничего, кроме возврата. Эта функция должна освобождать все ресурсы, связанные с этим контекстом.
.PP
\&\fBOSSL_FUNC_mac_dupctx()\fR должна дублировать контекст mac стороны провайдера в параметре \fImctx\fR и возвращать дубликат. \fBOSSL_FUNC_mac_init()\fR инициализирует операцию mac для только что созданного контекста mac стороны провайдера в параметре \fImctx\fR. Параметры \fIparams\fR устанавливаются перед установкой \s-1MAC\s0-ключа \fIkey\fR длиной \fIkeylen\fR байт.
.PP
\&\fBOSSL_FUNC_mac_update()\fR вызывается для передачи данных для вычисления \s-1MAC\s0 ранее инициализированной операции mac. Параметр \fImctx\fR содержит указатель на ранее инициализированный контекст стороны провайдера. \fBOSSL_FUNC_mac_update()\fR может вызываться несколько раз для одной операции mac.
.PP
\&\fBOSSL_FUNC_mac_final()\fR завершает вычисление \s-1MAC\s0, начатое предыдущими вызовами \fBOSSL_FUNC_mac_init()\fR и \fBOSSL_FUNC_mac_update()\fR. Параметр \fImctx\fR содержит указатель на контекст стороны провайдера. Результирующий \s-1MAC\s0 должен быть записан в \fIout\fR, а объём записанных данных — в \fI*outl\fR, который не должен превышать \fIoutsize\fR байт. Те же требования предъявляются к \fIoutsize\fR, как описано для \fBEVP_MAC_final\fR\|(3). Дополнительные сведения о структуре параметров, используемой этими функциями, см. в \s-1\fBOSSL_PARAM\s0\fR\|(3).
.PP
\&\fBOSSL_FUNC_mac_get_params()\fR получает сведения о значениях параметров, связанных с алгоритмом провайдера, и сохраняет их в \fIparams\fR.
.PP
\&\fBOSSL_FUNC_mac_set_ctx_params()\fR устанавливает параметры mac, связанные с заданным контекстом mac стороны провайдера \fImctx\fR, в \fIparams\fR. Любые настройки параметров добавляются к уже установленным. Передача \s-1NULL\s0 для \fIparams\fR должна возвращать true.
.PP
\&\fBOSSL_FUNC_mac_get_ctx_params()\fR получает сведения о текущих значениях параметров, связанных с заданным контекстом mac стороны провайдера \fImctx\fR, и сохраняет их в \fIparams\fR. Передача \s-1NULL\s0 для \fIparams\fR должна возвращать true.
.PP
\&\fBOSSL_FUNC_mac_gettable_params()\fR, \fBOSSL_FUNC_mac_gettable_ctx_params()\fR и \fBOSSL_FUNC_mac_settable_ctx_params()\fR все возвращают константные массивы \s-1\fBOSSL_PARAM\s0\fR\|(3) как дескрипторы параметров, которые \fBOSSL_FUNC_mac_get_params()\fR, \fBOSSL_FUNC_mac_get_ctx_params()\fR и \fBOSSL_FUNC_mac_set_ctx_params()\fR могут обрабатывать соответственно. \fBOSSL_FUNC_mac_gettable_ctx_params()\fR и \fBOSSL_FUNC_mac_settable_ctx_params()\fR возвращают параметры, связанные с контекстом стороны провайдера \fImctx\fR в его текущем состоянии, если он не \s-1NULL.\s0 В противном случае они возвращают параметры, связанные с алгоритмом стороны провайдера \fIprovctx\fR.
.PP
