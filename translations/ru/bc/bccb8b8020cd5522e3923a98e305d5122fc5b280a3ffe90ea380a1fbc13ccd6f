.Dt SFTP 1
.Os
.Sh ИМЯ
.Nm sftp
.Nd Защищённая передача файлов OpenSSH
.Sh СИНТАКСИС
.Nm sftp
.Op Fl 46AaCfNpqrv
.Op Fl B Ar размер_буфера
.Op Fl b Ar пакетный_файл
.Op Fl c Ar шифр
.Op Fl D Ar sftp_server_command
.Op Fl F Ar ssh_config
.Op Fl i Ar файл_идентификации
.Op Fl J Ar назначение
.Op Fl l Ar предел
