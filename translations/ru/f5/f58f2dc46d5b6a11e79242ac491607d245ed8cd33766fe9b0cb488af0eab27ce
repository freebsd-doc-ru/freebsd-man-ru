.Dd November 14, 2018
.Dt DIR 5
.Os
.Sh ИМЯ
.Nm dir ,
.Nm dirent
.Nd формат файла каталога
.Sh СИНТАКСИС
.In dirent.h
.Sh ОПИСАНИЕ
Каталоги обеспечивают удобный иерархический способ группировки
файлов, скрывая при этом подробности нижележащего носителя хранения.
Файл каталога отличается от обычного файла
флагом в его
.Xr inode 5
записи.
Он состоит из записей (элементов каталога), каждая из которых содержит
информацию о файле и указатель на сам файл.
Элементы каталога могут содержать другие каталоги,
а также обычные файлы; такие вложенные каталоги называются
подкаталогами.
Иерархия каталогов и файлов, сформированная таким образом,
называется файловой системой (или деревом файловой системы).
.Pp
Каждый файл каталога содержит два специальных элемента каталога; один — указатель
на сам каталог,
называемый точка
.Ql .\&
, а другой — указатель на его родительский каталог, называемый точка-точка
.Ql \&.. .
Точка и точка-точка
являются допустимыми именами путей, однако
корневой каталог системы
.Ql / ,
не имеет родителя, и точка-точка указывает на себя так же, как и точка.
.Pp
Узлы файловой системы — это обычные файлы каталогов, на которые был
смонтирован объект файловой системы, такой как физический диск или
область, разбитая на разделы такого диска.
(См.
.Xr mount 2
и
.Xr mount 8 . )
.Pp
Формат элемента каталога определён в файле
.In sys/dirent.h
(который не следует включать напрямую в приложения):
.Bd -literal
#ifndef	_SYS_DIRENT_H_
#define	_SYS_DIRENT_H_

#include <machine/ansi.h>

/*
 * Структура dirent определяет формат элементов каталога, возвращаемых
 * системным вызовом getdirentries(2).
 *
 * Элемент каталога имеет struct dirent в начале, содержащую его
 * номер inode, длину элемента и длину имени,
 * содержащегося в элементе.  Затем следует имя, дополненное до границы
 * в 8 байт нулевыми байтами.  Все имена гарантированно завершаются нулевым байтом.
 * Максимальная длина имени в каталоге — MAXNAMLEN.
 * Явное дополнение добавлено между последним членом заголовка и
 * d_name, чтобы избежать ABI-дополнения в конце dirent на
 * архитектурах LP64.  Есть код, зависящий от того, что d_name идёт последним.  Также
 * сохранение этого дополнения для архитектур ILP32 упрощает слой compat32.
 */

struct dirent {
	ino_t      d_fileno;		/* номер файла элемента */
	off_t      d_off;		/* смещение в каталоге следующего элемента */
	__uint16_t d_reclen;		/* длина этой записи */
	__uint8_t  d_type;		/* тип файла, см. ниже */
	__uint8_t  d_namlen;		/* длина строки в d_name */
	__uint32_t d_pad0;
#if __BSD_VISIBLE
#define	MAXNAMLEN	255
	char	d_name[MAXNAMLEN + 1];	/* имя не должно быть длиннее этого */
#else
	char	d_name[255 + 1];	/* имя не должно быть длиннее этого */
#endif
};

/*
 * Типы файлов
 */
#define	DT_UNKNOWN	 0
#define	DT_FIFO		 1
#define	DT_CHR		 2
#define	DT_DIR		 4
#define	DT_BLK		 6
#define	DT_REG		 8
#define	DT_LNK		10
#define	DT_SOCK		12
#define	DT_WHT		14

/*
 * Преобразование между типами структуры stat и типами каталога.
 */
#define	IFTODT(mode)	(((mode) & 0170000) >> 12)
#define	DTTOIF(dirtype)	((dirtype) << 12)

/*
 * Макрос _GENERIC_DIRSIZ даёт минимальную длину записи, которая вместит
 * элемент каталога.  Он возвращает объём пространства в struct direct
 * без поля d_name, плюс достаточно места для имени с завершающим
 * нулевым байтом (dp->d_namlen+1), округлённый вверх до границы в 8 байт.
 *
 * XXX хотя этот макрос находится в пространстве имён реализации, он требует
 * манифестной константы, которая таковой не является.
 */
#define	_GENERIC_DIRLEN(namlen)					\
	((__offsetof(struct dirent, d_name) + (namlen) + 1 + 7) & ~7)
#define	_GENERIC_DIRSIZ(dp)	_GENERIC_DIRLEN((dp)->d_namlen)
#endif /* __BSD_VISIBLE */

#ifdef _KERNEL
#define	GENERIC_DIRSIZ(dp)	_GENERIC_DIRSIZ(dp)
#endif

#endif /* !_SYS_DIRENT_H_ */
.Ed
