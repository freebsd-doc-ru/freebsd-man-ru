.Sh СИНТАКСИС
.Nm nc
.Bk -words
.Op Fl 46DdEFhklMNnrStUuvz
.Op Fl e Ar политика_IPsec
.Op Fl I Ar длина
.Op Fl i Ar интервал
.Op Fl -lb
.Op Fl -no-tcpopt
.Op Fl -sctp
.Op Fl -crlf
.Op Fl O Ar длина
.Op Fl P Ar имя_пользователя_прокси
.Op Fl p Ar порт_источника
.Op Fl s Ar источник
.Op Fl T Ar ключевое_слово_tos
.Op Fl -tun Ar устройство_tun
.Op Fl V Ar таблица_маршрутизации
