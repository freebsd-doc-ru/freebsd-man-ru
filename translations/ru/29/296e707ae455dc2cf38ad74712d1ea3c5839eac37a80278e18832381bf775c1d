provider\-digest \- Библиотека дайджестов <\-> функции провайдера
.Vb 2
\& #include <openssl/core_dispatch.h>
\& #include <openssl/core_names.h>
\&
\& /*
\&  * Дайджесты поддерживают следующие сигнатуры функций в массивах OSSL_DISPATCH.
\&  * (Сигнатуры функций не являются реальными функциями).
\&  */
\&
