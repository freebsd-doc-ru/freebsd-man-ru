.Xr stat 1 ,
.Xr ftruncate 2 ,
.Xr mmap 2 ,
.Xr read 2 ,
.Xr shm_open 2 ,
.Xr shm_unlink 2 ,
.Xr stat 2 ,
.Xr expand_number 3 ,
.Xr humanize_number 3 ,
.Xr shm_create_largepage 3 ,
.Xr sysctl 3
