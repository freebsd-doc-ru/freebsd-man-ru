.TH IPSEND 1
.SH ИМЯ
ipsend \- отправляет IP-пакеты
.SH СИНТАКСИС
.B ipsend
[
.B \-dITUv
] [
.B \-i
<interface>
] [
.B \-f
<\fIoffset\fP>
] [
.B \-g
<\fIgateway\fP>
] [
