.Nm ggatec
.Sh СИНТАКСИС
.Nm
.Cm create
.Op Fl n
.Op Fl v
.Op Fl o Cm ro | wo | rw
.Op Fl o Cm direct
.Op Fl p Ar порт
.Op Fl q Ar размер_очереди
.Op Fl R Ar размер_буфера_приёма
.Op Fl S Ar размер_буфера_отправки
.Op Fl s Ar размер_сектора
.Op Fl t Ar таймаут
.Op Fl u Ar номер_устройства
.Ar хост
.Ar путь
.Nm
.Cm rescue
.Op Fl n
.Op Fl v
.Op Fl o Cm ro | wo | rw
.Op Fl o Cm direct
.Op Fl p Ar порт
.Op Fl R Ar размер_буфера_приёма
.Op Fl S Ar размер_буфера_отправки
.Fl u Ar номер_устройства
