.Dd February 13, 2017
.Dt ACCT 5
.Os
.Sh ИМЯ
.Nm acct
.Nd файл учёта выполнения
.Sh СИНТАКСИС
.In sys/types.h
.In sys/acct.h
.Sh ОПИСАНИЕ
Ядро поддерживает следующую
.Fa acct
информационную структуру для всех
процессов.
Если процесс завершается и учёт включён,
ядро вызывает системный вызов
.Xr acct 2
чтобы подготовить и добавить запись
в файл учёта.
.Bd -literal
#define AC_COMM_LEN 16

/*
 * Структура учёта версии 3 (текущая).
 * Первый байт всегда равен нулю.
 * Единицы времени — микросекунды.
 */

struct acctv3 {
	uint8_t  ac_zero;		/* ноль идентифицирует новую версию */
	uint8_t  ac_version;		/* номер версии записи */
	uint16_t ac_len;		/* длина записи */

	char	  ac_comm[AC_COMM_LEN];	/* имя команды */
	float	  ac_utime;		/* пользовательское время */
	float	  ac_stime;		/* системное время */
	float	  ac_etime;		/* прошедшее время */
	time_t	  ac_btime;		/* время начала */
	uid_t	  ac_uid;		/* идентификатор пользователя */
	gid_t	  ac_gid;		/* идентификатор группы */
	float	  ac_mem;		/* среднее использование памяти */
	float	  ac_io;		/* количество блоков ввода-вывода */
	__dev_t   ac_tty;		/* управляющий tty */

	uint16_t ac_len2;		/* длина записи */
	union {
		uint32_t  ac_align;	/* принудительное выравнивание, совместимое с v1 */

#define	AFORK	0x01			/* порождён, но не запущен через exec */
/* ASU больше не поддерживается */
#define	ASU	0x02			/* использованы права суперпользователя */
#define	ACOMPAT	0x04			/* использован режим совместимости */
#define	ACORE	0x08			/* создан дамп памяти */
#define	AXSIG	0x10			/* убит сигналом */
#define ANVER	0x20			/* новая версия записи */

		uint8_t  ac_flag;	/* флаги учёта */
	} ac_trailer;

#define ac_flagx ac_trailer.ac_flag
};
.Ed
.Pp
Если завершённый процесс был создан посредством
.Xr execve 2 ,
имя исполняемого файла (не более десяти символов из него)
сохраняется в поле
.Fa ac_comm
а его статус сохраняется установкой одного или нескольких из следующих флагов в
.Fa ac_flag :
.Dv AFORK ,
.Dv ACOMPAT ,
.Dv ACORE
и
.Dv ASIG .
.Dv ASU
больше не поддерживается.
.Dv ANVER
всегда устанавливается в вышеуказанной структуре.
.Sh СМ. ТАКЖЕ
.Xr lastcomm 1 ,
.Xr acct 2 ,
.Xr execve 2 ,
.Xr sa 8
.Sh ИСТОРИЯ
Формат файла
.Nm
появился в
.At v7 .
Текущий формат записи был введён в мае 2007 года.
Он обратно совместим с предыдущим форматом,
который по-прежнему документирован в
.In sys/acct.h
и поддерживается
.Xr lastcomm 1
и
.Xr sa 8 .
