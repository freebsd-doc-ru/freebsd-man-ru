\&  * Ни одна из этих функций не является реальной функцией, но они показаны так
\&  * для сигнатур функций, которые предлагаются как указатели на функции
\&  * в массивах OSSL_DISPATCH.
\&  */
\&
\& void *OSSL_FUNC_store_open(void *provctx, const char *uri);
\& void *OSSL_FUNC_store_attach(void *provctx, OSSL_CORE_BIO *bio);
