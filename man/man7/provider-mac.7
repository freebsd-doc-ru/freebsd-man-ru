.SH ИМЯ
provider\-mac \- Функции библиотеки MAC <\-> провайдера
.SH СИНТАКСИС
.Vb 2
\& #include <openssl/core_dispatch.h>
\& #include <openssl/core_names.h>
\&
\& /*
\&  * Ни одна из них не является настоящей функцией, но они показаны так для
\&  * сигнатур функций, которые предлагаются как указатели на функции
\&  * в массивах OSSL_DISPATCH.
\&  */
\&
\& /* Управление контекстом */
\& void *OSSL_FUNC_mac_newctx(void *provctx);
\& void OSSL_FUNC_mac_freectx(void *mctx);
\& void *OSSL_FUNC_mac_dupctx(void *src);
\&
\& /* Шифрование/дешифрование */
\& int OSSL_FUNC_mac_init(void *mctx, unsigned char *key, size_t keylen,
\&                        const OSSL_PARAM params[]);
\& int OSSL_FUNC_mac_init_skey(void *mctx, const void *key, const OSSL_PARAM params[]);
\& int OSSL_FUNC_mac_update(void *mctx, const unsigned char *in, size_t inl);
\& int OSSL_FUNC_mac_final(void *mctx, unsigned char *out, size_t *outl, size_t outsize);
\&
\& /* Дескрипторы параметров MAC */
\& const OSSL_PARAM *OSSL_FUNC_mac_gettable_params(void *provctx);
\& const OSSL_PARAM *OSSL_FUNC_mac_gettable_ctx_params(void *mctx, void *provctx);
\& const OSSL_PARAM *OSSL_FUNC_mac_settable_ctx_params(void *mctx, void *provctx);
\&
\& /* Параметры MAC */
\& int OSSL_FUNC_mac_get_params(OSSL_PARAM params[]);
\& int OSSL_FUNC_mac_get_ctx_params(void *mctx, OSSL_PARAM params[]);
\& int OSSL_FUNC_mac_set_ctx_params(void *mctx, const OSSL_PARAM params[]);
.Ve
.SH ОПИСАНИЕ
Эта документация в первую очередь предназначена для авторов провайдеров. См. \fBprovider\fR\|(7)
для получения дополнительной информации.
.PP
Операция MAC позволяет провайдерам реализовывать алгоритмы MAC и делать
их доступными приложениям через функции API \fBEVP_MAC_init\fR\|(3),
\&\fBEVP_MAC_update\fR\|(3) и \fBEVP_MAC_final\fR\|(3).
.PP
\&\fIlibcrypto\fR и провайдер в массивах \fBOSSL_DISPATCH\fR\|(3) через
\&\fBOSSL_ALGORITHM\fR\|(3) массивы, которые возвращаются функцией
\&\fBprovider_query_operation()\fR провайдера
.PP
с именем \fBOSSL_FUNC_{name}_fn\fR, и вспомогательная функция для извлечения
указателя на функцию из элемента \fBOSSL_DISPATCH\fR\|(3) с именем
\&\fBOSSL_FUNC_{name}\fR.
.PP
.Vb 3
\& typedef void *(OSSL_FUNC_mac_newctx_fn)(void *provctx);
\& static ossl_inline OSSL_FUNC_mac_newctx_fn
\&     OSSL_FUNC_mac_newctx(const OSSL_DISPATCH *opf);
.Ve
.PP
\&\fBOSSL_DISPATCH\fR\|(3) массивы индексируются числами, которые предоставляются как
макросы в \fBopenssl\-core_dispatch.h\fR\|(7), следующим образом:
.PP
.Vb 3
\& OSSL_FUNC_mac_newctx               OSSL_FUNC_MAC_NEWCTX
\& OSSL_FUNC_mac_freectx              OSSL_FUNC_MAC_FREECTX
\& OSSL_FUNC_mac_dupctx               OSSL_FUNC_MAC_DUPCTX
\&
\& OSSL_FUNC_mac_init                 OSSL_FUNC_MAC_INIT
\& OSSL_FUNC_mac_init_skey            OSSL_FUNC_MAC_INIT_SKEY
\& OSSL_FUNC_mac_update               OSSL_FUNC_MAC_UPDATE
\& OSSL_FUNC_mac_final                OSSL_FUNC_MAC_FINAL
\&
\& OSSL_FUNC_mac_get_params           OSSL_FUNC_MAC_GET_PARAMS
\& OSSL_FUNC_mac_get_ctx_params       OSSL_FUNC_MAC_GET_CTX_PARAMS
\& OSSL_FUNC_mac_set_ctx_params       OSSL_FUNC_MAC_SET_CTX_PARAMS
\&
\& OSSL_FUNC_mac_gettable_params      OSSL_FUNC_MAC_GETTABLE_PARAMS
\& OSSL_FUNC_mac_gettable_ctx_params  OSSL_FUNC_MAC_GETTABLE_CTX_PARAMS
\& OSSL_FUNC_mac_settable_ctx_params  OSSL_FUNC_MAC_SETTABLE_CTX_PARAMS
.Ve
.PP
Реализация алгоритма MAC может не реализовывать все эти функции.
Чтобы набор функций был согласованным, должны быть реализованы по крайней мере следующие функции:
\&\fBOSSL_FUNC_mac_newctx()\fR, \fBOSSL_FUNC_mac_freectx()\fR,
по крайней мере одна из \fBOSSL_FUNC_mac_init()\fR или \fBOSSL_FUNC_mac_init_skey()\fR,
\&\fBOSSL_FUNC_mac_update()\fR, \fBOSSL_FUNC_mac_final()\fR.
Все остальные функции необязательны.
\&\fBOSSL_FUNC_mac_newctx()\fR должна создавать и возвращать указатель на структуру
на стороне провайдера для хранения информации о контексте во время операции MAC.
Указатель на этот контекст будет передаваться обратно в ряде других вызовов
функций операций MAC.
Параметр \fIprovctx\fR — это контекст провайдера, созданный во время
инициализации провайдера (см. \fBprovider\fR\|(7)).
.PP
\&\fBOSSL_FUNC_mac_freectx()\fR получает указатель на контекст MAC на стороне провайдера
в параметре \fImctx\fR.
Если она получает NULL в качестве значения \fImctx\fR, она не должна делать ничего, кроме
возврата.
Эта функция должна освобождать любые ресурсы, связанные с этим контекстом.
.PP
\&\fBOSSL_FUNC_mac_dupctx()\fR должна дублировать контекст MAC на стороне провайдера в
параметре \fImctx\fR и возвращать дубликат.
\&\fBOSSL_FUNC_mac_init()\fR инициализирует операцию MAC с использованием только что созданного
контекста MAC на стороне провайдера в параметре \fImctx\fR.  \fIparams\fR устанавливаются перед установкой
ключа MAC \fIkey\fR длиной \fIkeylen\fR байт.
.PP
\&\fBOSSL_FUNC_mac_init_skey()\fR аналогична, но использует непрозрачный объект, специфичный для провайдера,
для инициализации контекста MAC.
.PP
\&\fBOSSL_FUNC_mac_update()\fR вызывается для передачи данных для вычисления MAC ранее
инициализированной операции MAC.
Параметр \fImctx\fR содержит указатель на ранее инициализированный контекст
на стороне провайдера.
\&\fBOSSL_FUNC_mac_update()\fR может вызываться несколько раз для одной операции MAC.
.PP
\&\fBOSSL_FUNC_mac_final()\fR завершает вычисление MAC, начатое предыдущими
вызовами \fBOSSL_FUNC_mac_init()\fR и \fBOSSL_FUNC_mac_update()\fR.
Параметр \fImctx\fR содержит указатель на контекст на стороне провайдера.
Результирующий MAC должен быть записан в \fIout\fR, а количество записанных данных —
в \fI*outl\fR; оно не должно превышать \fIoutsize\fR байт.
К \fIoutsize\fR предъявляются те же требования, что документированы для
\&\fBEVP_MAC_final\fR\|(3).
См. \fBOSSL_PARAM\fR\|(3) для получения дополнительных сведений о структуре параметров, используемой
этими функциями.
.PP
\&\fBOSSL_FUNC_mac_get_params()\fR получает сведения о значениях параметров, связанных с
алгоритмом провайдера, и сохраняет их в \fIparams\fR.
.PP
\&\fBOSSL_FUNC_mac_set_ctx_params()\fR устанавливает параметры MAC, связанные с заданным
контекстом MAC на стороне провайдера \fImctx\fR, в \fIparams\fR.
Любые настройки параметров добавляются к тем, что были установлены ранее.
Передача NULL для \fIparams\fR должна возвращать true.
.PP
\&\fBOSSL_FUNC_mac_get_ctx_params()\fR получает сведения о текущих значениях параметров,
связанных с заданным контекстом MAC на стороне провайдера \fImctx\fR, и сохраняет их
в \fIparams\fR.
Передача NULL для \fIparams\fR должна возвращать true.
.PP
\&\fBOSSL_FUNC_mac_gettable_params()\fR, \fBOSSL_FUNC_mac_gettable_ctx_params()\fR
и \fBOSSL_FUNC_mac_settable_ctx_params()\fR все возвращают константные массивы \fBOSSL_PARAM\fR\|(3)
в качестве дескрипторов параметров, которые могут обрабатывать
\&\fBOSSL_FUNC_mac_get_params()\fR, \fBOSSL_FUNC_mac_get_ctx_params()\fR и \fBOSSL_FUNC_mac_set_ctx_params()\fR
соответственно.  \fBOSSL_FUNC_mac_gettable_ctx_params()\fR и
\&\fBOSSL_FUNC_mac_settable_ctx_params()\fR будут возвращать параметры, связанные
с контекстом на стороне провайдера \fImctx\fR в его текущем состоянии, если он
не NULL.  В противном случае они возвращают параметры, связанные с
алгоритмом на стороне провайдера \fIprovctx\fR.
.PP
Все реализации MAC должны обрабатывать следующие параметры:
.RS 4
.PD 0
.PD
Устанавливает ключ в связанном контексте MAC.  Это идентично передаче аргумента \fIkey\fR
в функцию \fBOSSL_FUNC_mac_init()\fR.
.RE
.RS 4
.RE
.RS 4
.PD 0
.PD
Может использоваться для получения размера MAC по умолчанию (который может быть единственным допустимым
размером MAC для реализации).
.Sp
Обратите внимание, что некоторые реализации также позволяют задавать размер, который должен иметь
результирующий MAC; см. документацию реализации.
.RE
.RS 4
Может использоваться для получения размера блока MAC (если это поддерживается алгоритмом).
.RE
.RS 4
.RE
.PP
Провайдер OpenSSL FIPS может поддерживать следующие параметры:
