.SH ПРИМЕРЫ
Ниже приведён простой обратный вызов самопроверки для иллюстрации.
.PP
.Vb 1
\&  #include <openssl/self_test.h>
\&
\&  static OSSL_CALLBACK self_test_cb;
\&
\&  static int self_test_cb(const OSSL_PARAM params[], void *arg)
\&  {
\&    int ret = 0;
\&    const OSSL_PARAM *p = NULL;
\&    const char *phase = NULL, *type = NULL, *desc = NULL;
\&
\&    p = OSSL_PARAM_locate_const(params, OSSL_PROV_PARAM_SELF_TEST_PHASE);
\&    if (p == NULL || p\->data_type != OSSL_PARAM_UTF8_STRING)
\&        goto err;
\&    phase = (const char *)p\->data;
\&
\&    p = OSSL_PARAM_locate_const(params, OSSL_PROV_PARAM_SELF_TEST_DESC);
\&    if (p == NULL || p\->data_type != OSSL_PARAM_UTF8_STRING)
\&        goto err;
\&    desc = (const char *)p\->data;
\&
\&    p = OSSL_PARAM_locate_const(params, OSSL_PROV_PARAM_SELF_TEST_TYPE);
\&    if (p == NULL || p\->data_type != OSSL_PARAM_UTF8_STRING)
\&        goto err;
\&    type = (const char *)p\->data;
\&
\&    /* Выполнить некоторое журналирование */
\&    if (strcmp(phase, OSSL_SELF_TEST_PHASE_START) == 0)
\&    if (strcmp(phase, OSSL_SELF_TEST_PHASE_PASS) == 0
\&            || strcmp(phase, OSSL_SELF_TEST_PHASE_FAIL) == 0)
\&
\&    /* Повредить самопроверку SHA1 во время фазы \*(Aqcorrupt\*(Aq, вернув 0 */
\&    if (strcmp(phase, OSSL_SELF_TEST_PHASE_CORRUPT) == 0
\&            && strcmp(desc, OSSL_SELF_TEST_DESC_MD_SHA1) == 0) {
\&        return 0;
\&    }
\&    ret = 1;
\&  err:
\&    return ret;
\&  }
.Ve
.SH ПРИМЕЧАНИЯ
Некоторые выпущенные версии OpenSSL не включают проверенный
провайдер FIPS.  Чтобы определить, какие версии прошли
процесс валидации, обратитесь к
странице загрузок OpenSSL <https://www.openssl.org/source/>.  Если вам
нужна функциональность, одобренная FIPS, необходимо собрать ваш провайдер
FIPS, используя одну из проверенных версий, перечисленных там.  Обычно
можно использовать провайдер FIPS, собранный из одной из
проверенных версий, вместе с \fIlibcrypto\fR и \fIlibssl\fR, скомпилированными из любого
выпуска в той же серии основных выпусков.  Эта гибкость позволяет
применять исправления ошибок и CVE, выходящие за границы FIPS.
.PP
Вы можете загрузить провайдер FIPS в несколько контекстов библиотеки, как и любой другой
провайдер. Однако применяется следующее ограничение. Провайдер FIPS не может
использоваться несколькими копиями OpenSSL libcrypto в одном процессе.
.PP
Поскольку провайдер сохраняет основные обратные вызовы в libcrypto, полученные в
вызове \&\fBOSSL_provider_init()\fR, в глобальные данные, он завершится с ошибкой, если последующие
вызовы его функции \fBOSSL_provider_init()\fR дадут другие адреса
этих обратных вызовов, чем при первоначальном вызове. Это происходит, когда разные
копии libcrypto присутствуют в памяти процесса и обе пытаются
загрузить один и тот же провайдер FIPS. Обходной путь — загрузить отдельную копию
провайдера FIPS для каждого экземпляра libcrypto в
процессе.
