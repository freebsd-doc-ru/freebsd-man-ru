.SH ИМЯ
provider\-digest \- Библиотека дайджестов <\-> функции провайдера
.SH СИНТАКСИС
.Vb 2
\& #include <openssl/core_dispatch.h>
\& #include <openssl/core_names.h>
\&
\& /*
\&  * Дайджесты поддерживают следующие сигнатуры функций в массивах OSSL_DISPATCH.
\&  * (Сигнатуры функций не являются фактическими функциями).
\&  */
\&
\& /* Управление контекстом */
\& void *OSSL_FUNC_digest_newctx(void *provctx);
\& void OSSL_FUNC_digest_freectx(void *dctx);
\& void *OSSL_FUNC_digest_dupctx(void *dctx);
\& void OSSL_FUNC_digest_copyctx(void *voutctx, void *vinctx);
\&
\& /* Генерация дайджеста */
\& int OSSL_FUNC_digest_init(void *dctx, const OSSL_PARAM params[]);
\& int OSSL_FUNC_digest_update(void *dctx, const unsigned char *in, size_t inl);
\& int OSSL_FUNC_digest_final(void *dctx, unsigned char *out, size_t *outl,
\&                            size_t outsz);
\& int OSSL_FUNC_digest_digest(void *provctx, const unsigned char *in, size_t inl,
\&                             unsigned char *out, size_t *outl, size_t outsz);
\&
\& /* Дескрипторы параметров дайджеста */
\& const OSSL_PARAM *OSSL_FUNC_digest_gettable_params(void *provctx);
\&
\& /* Дескрипторы параметров операции дайджеста */
\& const OSSL_PARAM *OSSL_FUNC_digest_gettable_ctx_params(void *dctx,
\&                                                        void *provctx);
\& const OSSL_PARAM *OSSL_FUNC_digest_settable_ctx_params(void *dctx,
\&                                                        void *provctx);
\&
\& /* Параметры дайджеста */
\& int OSSL_FUNC_digest_get_params(OSSL_PARAM params[]);
\&
\& /* Параметры операции дайджеста */
\& int OSSL_FUNC_digest_set_ctx_params(void *dctx, const OSSL_PARAM params[]);
\& int OSSL_FUNC_digest_get_ctx_params(void *dctx, OSSL_PARAM params[]);
.Ve
.SH ОПИСАНИЕ
Эта документация в первую очередь предназначена для авторов провайдеров. Дополнительную информацию см. в \fBprovider\fR\|(7).
.PP
Операция DIGEST позволяет провайдерам реализовывать алгоритмы дайджестов и делать
их доступными приложениям через функции API \fBEVP_DigestInit_ex\fR\|(3),
\&\fBEVP_DigestUpdate\fR\|(3) и \fBEVP_DigestFinal\fR\|(3) (а также другие связанные функции).
.PP
\&\fIlibcrypto\fR и провайдер в массивах \fBOSSL_DISPATCH\fR\|(3) через
\&\fBOSSL_ALGORITHM\fR\|(3) массивы, возвращаемые функцией провайдера
\&\fBprovider_query_operation()\fR
.PP
с именем \fBOSSL_FUNC_{name}_fn\fR, и вспомогательную функцию для получения
указателя на функцию из элемента \fBOSSL_DISPATCH\fR\|(3) с именем
\&\fBOSSL_FUNC_{name}\fR.
.PP
.Vb 3
\& typedef void *(OSSL_FUNC_digest_newctx_fn)(void *provctx);
\& static ossl_inline OSSL_FUNC_digest_newctx_fn
\&     OSSL_FUNC_digest_newctx(const OSSL_DISPATCH *opf);
.Ve
.PP
\&\fBOSSL_DISPATCH\fR\|(3) массивы индексируются числами, которые предоставляются как
макросы в \fBopenssl\-core_dispatch.h\fR\|(7), следующим образом:
.PP
.Vb 4
\& OSSL_FUNC_digest_newctx               OSSL_FUNC_DIGEST_NEWCTX
\& OSSL_FUNC_digest_freectx              OSSL_FUNC_DIGEST_FREECTX
\& OSSL_FUNC_digest_dupctx               OSSL_FUNC_DIGEST_DUPCTX
\& OSSL_FUNC_digest_copyctx              OSSL_FUNC_DIGEST_COPYCTX
\&
\& OSSL_FUNC_digest_init                 OSSL_FUNC_DIGEST_INIT
\& OSSL_FUNC_digest_update               OSSL_FUNC_DIGEST_UPDATE
\& OSSL_FUNC_digest_final                OSSL_FUNC_DIGEST_FINAL
\& OSSL_FUNC_digest_digest               OSSL_FUNC_DIGEST_DIGEST
\&
\& OSSL_FUNC_digest_get_params           OSSL_FUNC_DIGEST_GET_PARAMS
\& OSSL_FUNC_digest_get_ctx_params       OSSL_FUNC_DIGEST_GET_CTX_PARAMS
\& OSSL_FUNC_digest_set_ctx_params       OSSL_FUNC_DIGEST_SET_CTX_PARAMS
\&
\& OSSL_FUNC_digest_gettable_params      OSSL_FUNC_DIGEST_GETTABLE_PARAMS
\& OSSL_FUNC_digest_gettable_ctx_params  OSSL_FUNC_DIGEST_GETTABLE_CTX_PARAMS
\& OSSL_FUNC_digest_settable_ctx_params  OSSL_FUNC_DIGEST_SETTABLE_CTX_PARAMS
.Ve
.PP
Реализация алгоритма дайджеста может реализовывать не все эти функции.
Чтобы быть пригодной к использованию, должны быть реализованы все или ни одна из функций OSSL_FUNC_digest_newctx, OSSL_FUNC_digest_freectx,
OSSL_FUNC_digest_init, OSSL_FUNC_digest_update, OSSL_FUNC_digest_final
и OSSL_FUNC_digest_get_params.
Все остальные функции необязательны.
\fBOSSL_FUNC_digest_newctx()\fR должна создать и вернуть указатель на структуру
на стороне провайдера для хранения информации о контексте во время операции дайджеста.
Указатель на этот контекст будет передан обратно в ряде других вызовов
функций операции дайджеста.
Параметр \fIprovctx\fR — это контекст провайдера, созданный во время инициализации
провайдера (см. \fBprovider\fR\|(7)).
.PP
\fBOSSL_FUNC_digest_freectx()\fR передаётся указатель на контекст дайджеста на стороне
провайдера в параметре \fIdctx\fR.
Эта функция должна освободить любые ресурсы, связанные с этим контекстом.
.PP
\fBOSSL_FUNC_digest_dupctx()\fR должна дублировать контекст дайджеста на стороне провайдера
в параметре \fIdctx\fR и вернуть дублированную копию.
.PP
\fBOSSL_FUNC_digest_copyctx()\fR должна копировать контекст дайджеста на стороне провайдера
из параметра \fIvinctx\fR в параметр \fIvoutctx\fR, который является другим контекстом
на стороне провайдера.
Функция OSSL_FUNC_digest_copyctx используется в функции EVP_MD_CTX_copy_ex, чтобы
ускорить операции HMAC в PBKDF2.
Эта функция необязательна, и dupctx будет использоваться, если функции EVP_MD_CTX_copy_ex
нет.
\fBOSSL_FUNC_digest_init()\fR инициализирует операцию дайджеста с использованием только что созданного
контекста дайджеста на стороне провайдера в параметре \fIdctx\fR.
Если \fIparams\fR не равен NULL, его следует установить в контексте способом, аналогичным
использованию \fBOSSL_FUNC_digest_set_ctx_params()\fR.
.PP
\fBOSSL_FUNC_digest_update()\fR вызывается для предоставления данных, которые нужно обработать дайджестом, как часть
ранее инициализированной операции дайджеста.
Параметр \fIdctx\fR содержит указатель на ранее инициализированный контекст
на стороне провайдера.
\fBOSSL_FUNC_digest_update()\fR должна вычислить дайджест для \fIinl\fR байт данных в месте, на которое указывает
\fIin\fR.
\fBOSSL_FUNC_digest_update()\fR может вызываться несколько раз для одной операции дайджеста.
.PP
\fBOSSL_FUNC_digest_final()\fR генерирует дайджест, начатый предыдущими вызовами \fBOSSL_FUNC_digest_init()\fR
и \fBOSSL_FUNC_digest_update()\fR.
Параметр \fIdctx\fR содержит указатель на контекст на стороне провайдера.
Дайджест должен быть записан в \fI*out\fR, а длина дайджеста — в
\fI*outl\fR.
Дайджест не должен превышать \fIoutsz\fR байт.
.PP
Контекст дайджеста на стороне провайдера не используется.
Вместо этого контекст провайдера, созданный во время инициализации провайдера,
передаётся в параметре \fIprovctx\fR (см. \fBprovider\fR\|(7)).
Должен быть вычислен дайджест для \fIinl\fR байт в \fIin\fR, а результат должен быть сохранён в
\fIout\fR. Длина дайджеста должна быть сохранена в \fI*outl\fR, которая не должна
превышать \fIoutsz\fR байт.
Дополнительные сведения о структуре параметров, используемой этими функциями,
см. в \fBOSSL_PARAM\fR\|(3).
.PP
\fBOSSL_FUNC_digest_get_params()\fR получает сведения о реализации алгоритма
и сохраняет их в \fIparams\fR.
.PP
\fBOSSL_FUNC_digest_set_ctx_params()\fR устанавливает параметры операции дайджеста для
контекста дайджеста на стороне провайдера \fIdctx\fR в \fIparams\fR.
Любые настройки параметров дополняют любые ранее установленные.
Передача NULL для \fIparams\fR должна возвращать true.
.PP
\fBOSSL_FUNC_digest_get_ctx_params()\fR получает сведения об операции дайджеста из
заданного контекста дайджеста на стороне провайдера \fIdctx\fR и сохраняет их в \fIparams\fR.
Передача NULL для \fIparams\fR должна возвращать true.
.PP
\fBOSSL_FUNC_digest_gettable_params()\fR возвращает константный массив \fBOSSL_PARAM\fR\|(3),
содержащий дескрипторы параметров, которые может обрабатывать \fBOSSL_FUNC_digest_get_params()\fR.
.PP
\fBOSSL_FUNC_digest_gettable_ctx_params()\fR и
\fBOSSL_FUNC_digest_settable_ctx_params()\fR обе возвращают константные
массивы \fBOSSL_PARAM\fR\|(3) в качестве дескрипторов параметров, которые
\fBOSSL_FUNC_digest_get_ctx_params()\fR и \fBOSSL_FUNC_digest_set_ctx_params()\fR
могут обрабатывать соответственно. Массив основан на текущем состоянии
контекста на стороне провайдера, если \fIdctx\fR не равен NULL, и на
алгоритме на стороне провайдера \fIprovctx\fR в противном случае.
.PP
Параметры, распознаваемые встроенными дайджестами с помощью этой функции
в настоящее время, следующие. Не все параметры относятся ко всем дайджестам
или понимаются всеми дайджестами:
Размер блока дайджеста.
Размер вывода дайджеста.
Различные флаги, описывающие особое поведение дайджеста:
.RS 4
.IP \fBEVP_MD_FLAG_ONESHOT\fR 4
Этот метод дайджеста может обрабатывать только один блок входных данных.
.IP \fBEVP_MD_FLAG_XOF\fR 4
Этот метод дайджеста является функцией с расширяемым выводом (XOF).
.IP \fBEVP_MD_FLAG_DIGALGID_NULL\fR 4
При настройке DigestAlgorithmIdentifier этот флаг по умолчанию устанавливает
параметр в NULL.  Используйте это для PKCS#1.  \fIПримечание: если
объединить с EVP_MD_FLAG_DIGALGID_ABSENT, последний переопределит.\fR
.IP \fBEVP_MD_FLAG_DIGALGID_ABSENT\fR 4
При настройке DigestAlgorithmIdentifier этот флаг по умолчанию оставляет
параметр отсутствующим.  \fIПримечание: если объединить с
EVP_MD_FLAG_DIGALGID_NULL, последний будет переопределён.\fR
.IP \fBEVP_MD_FLAG_DIGALGID_CUSTOM\fR 4
Пользовательская обработка DigestAlgorithmIdentifier через ctrl, с
\&\fBEVP_MD_FLAG_DIGALGID_ABSENT\fR по умолчанию.  \fIПримечание: если объединить с
EVP_MD_FLAG_DIGALGID_NULL, последний будет переопределён.\fR
В настоящее время не используется.
.RE
.RS 4
.Sp
\&\fBunsigned long int\fR.
.RE
\fBOSSL_FUNC_digest_set_ctx_params()\fR устанавливает параметры дайджеста, связанные с
заданным контекстом дайджеста на стороне провайдера \fIdctx\fR, в \fIparams\fR.
Любые настройки параметров дополняют любые ранее установленные.
Дополнительные сведения о структуре параметров см. в \fBOSSL_PARAM\fR\|(3).
.PP
\fBOSSL_FUNC_digest_get_ctx_params()\fR получает сведения о текущих установленных значениях параметров,
связанных с заданным контекстом дайджеста на стороне провайдера \fIdctx\fR,
и сохраняет их в \fIparams\fR.
Дополнительные сведения о структуре параметров см. в \fBOSSL_PARAM\fR\|(3).
.PP
Провайдер OpenSSL FIPS поддерживает следующий получаемый параметр контекста:
Возвращает 1, если операция одобрена FIPS, или 0 в противном случае.
\fBOSSL_FUNC_digest_newctx()\fR и \fBOSSL_FUNC_digest_dupctx()\fR должны возвращать только что созданный
контекст дайджеста на стороне провайдера или NULL в случае ошибки.
.PP
\fBOSSL_FUNC_digest_init()\fR, \fBOSSL_FUNC_digest_update()\fR, \fBOSSL_FUNC_digest_final()\fR, \fBOSSL_FUNC_digest_digest()\fR,
\fBOSSL_FUNC_digest_set_params()\fR и \fBOSSL_FUNC_digest_get_params()\fR должны возвращать 1 при успехе или
0 при ошибке.
.PP
\fBOSSL_FUNC_digest_size()\fR должна возвращать размер дайджеста.
.PP
\fBOSSL_FUNC_digest_block_size()\fR должна возвращать размер блока базового алгоритма
дайджеста.
.SH ИЗВЕСТНЫЕ ОШИБКИ
Вызовы API \fBEVP_Q_digest()\fR, \fBEVP_Digest()\fR и \fBEVP_DigestFinal_ex()\fR не
предполагают, что размер дайджеста будет больше EVP_MAX_MD_SIZE. Любой алгоритм, который
создаёт дайджесты большего размера, непригоден для использования с этими вызовами API.
\&\fBprovider\fR\|(7), \fBOSSL_PROVIDER\-FIPS\fR\|(7), \fBOSSL_PROVIDER\-default\fR\|(7),
\&\fBOSSL_PROVIDER\-legacy\fR\|(7),
\&\fBEVP_MD\-common\fR\|(7), \fBEVP_MD\-BLAKE2\fR\|(7), \fBEVP_MD\-MD2\fR\|(7),
\&\fBEVP_MD\-MD4\fR\|(7), \fBEVP_MD\-MD5\fR\|(7), \fBEVP_MD\-MD5\-SHA1\fR\|(7),
\&\fBEVP_MD\-MDC2\fR\|(7), \fBEVP_MD\-RIPEMD160\fR\|(7), \fBEVP_MD\-SHA1\fR\|(7),
\&\fBEVP_MD\-SHA2\fR\|(7), \fBEVP_MD\-SHA3\fR\|(7), \fBEVP_MD\-KECCAK\fR\|(7)
\&\fBEVP_MD\-SHAKE\fR\|(7), \fBEVP_MD\-SM3\fR\|(7), \fBEVP_MD\-WHIRLPOOL\fR\|(7),
\&\fBEVP_MD\-NULL\fR\|(7),
\&\fBlife_cycle\-digest\fR\|(7), \fBEVP_DigestInit\fR\|(3)
