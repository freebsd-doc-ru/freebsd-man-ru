.SH ИМЯ
ossl_store \- функции извлечения из хранилища
.SH СИНТАКСИС
#include <openssl/store.h>
.SH ОПИСАНИЕ
.SS Общие сведения
STORE — это слой функциональности для извлечения ряда поддерживаемых
объектов из хранилища любого типа, адресуемого как имя файла или
как URI.
.PP
.PP
Извлечённые объекты возвращаются как тип-обёртка \fBOSSL_STORE_INFO\fR,
из которого можно получить тип OpenSSL.
динамически из вызывающего приложения или из загружаемого движка.
.PP
Поддержка схемы 'file' встроена в \f(CW\*(C`libcrypto\*(C'\fR.
Дополнительные сведения см. в \fBossl_store\-file\fR\|(7).
API \fBOSS_STORE\fR не накладывает никаких требований на конкретный формат или
кодировку парольной фразы, которую предоставляет \fBUI_METHOD\fR.  Однако
предполагается, что парольная фраза закодирована в UTF\-8.  Результат любой
другой кодировки не определён.
.SH ПРИМЕРЫ
.Vb 2
\& #include <openssl/ui.h> /* для UI_get_default_method */
\& #include <openssl/store.h>
\&
\&                        UI_get_default_method(), NULL, NULL, NULL);
\&
\& /*
\&  * OSSL_STORE_eof() имитирует файловую семантику для любого репозитория, чтобы
\&  * сигнализировать, что больше данных не ожидается
\&  */
\& while (!OSSL_STORE_eof(ctx)) {
\&     OSSL_STORE_INFO *info = OSSL_STORE_load(ctx);
\&
\&     /*
\&      * Делайте всё необходимое с OSSL_STORE_INFO,
\&      * здесь приведён только один пример
\&      */
\&     switch (OSSL_STORE_INFO_get_type(info)) {
\&     case OSSL_STORE_INFO_CERT:
\&         /* Вывести текст сертификата X.509 */
\&         X509_print_fp(stdout, OSSL_STORE_INFO_get0_CERT(info));
\&         /* Вывести сертификат X.509 в формате PEM */
\&         PEM_write_X509(stdout, OSSL_STORE_INFO_get0_CERT(info));
\&         break;
\&     }
\&     OSSL_STORE_INFO_free(info);
\& }
\&
\& OSSL_STORE_close(ctx);
