.Dd October 30, 2007
.Dt SCTP_GENERIC_SENDMSG 2
.Os
.Sh ИМЯ
.Nm sctp_generic_sendmsg ,
.Nm sctp_generic_sendmsg_iov
.Nd отправка данных партнёру
.Sh БИБЛИОТЕКА
.Lb libc
.Sh SYNOPSIS
.In sys/types.h
.In sys/socket.h
.In netinet/sctp.h
.Ft int
.Fn sctp_generic_sendmsg "int s" "void *msg" "int msglen" "struct sockaddr *to" "socklen_t len" "struct sctp_sndrcvinfo *sinfo" "int flags"
.Ft int
.Fn sctp_generic_sendmsg_iov "int s" "struct iovec *iov" "int iovlen" "struct sockaddr *to" "struct sctp_sndrcvinfo *sinfo" "int flags"
.Sh ОПИСАНИЕ
.Fn sctp_generic_sendmsg
и
.Fn sctp_generic_sendmsg_iov
являются настоящими системными вызовами, используемыми
функциями
.Xr sctp_sendmsg 3
и
.Xr sctp_send 3 .
Они более эффективны, поскольку являются
настоящими системными вызовами, но они специфичны для
.Fx
и можно ожидать, что они
.Em не
будут присутствовать ни в одной другой операционной
системе.
Подробности использования см. в описании функций
.Xr sctp_send 3
или
.Xr sctp_sendmsg 3 .
.Sh ВОЗВРАЩАЕМЫЕ ЗНАЧЕНИЯ
При успешном завершении вызов возвращает количество записанных байтов, при ошибке — -1.
.Sh ОШИБКИ
.Bl -tag -width Er
.It Bq Er EBADF
Аргумент
.Fa s
не является допустимым дескриптором.
.It Bq Er ENOTSOCK
Аргумент
.Fa s
не является сокетом.
.El
.Sh СМ. ТАКЖЕ
.Xr sctp_send 3 ,
.Xr sctp_sendmsg 3 ,
.Xr sctp_sendmsgx 3 ,
.Xr sctp_sendx 3 ,
.Xr sctp 4
